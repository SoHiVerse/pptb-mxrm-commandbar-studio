{
  "compilerOptions": {
    "composite": true,
	"outDir": "./node_modules/.cache/cbs-config",
	"tsBuildInfoFile": "./node_modules/.cache/cbs-config/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "vite.onprem.config.ts", "vitest.config.ts", "commitlint.config.ts"]
}
