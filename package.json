{
	"name": "@mohsinonxrm/pptb-commandbar-studio",
	"version": "0.5.3-beta.1",
	"displayName": "Command Bar Studio",
	"description": "Visual designer for Dataverse classic ribbon / command bar customizations — the spiritual successor to Ribbon Workbench, built for Power Platform ToolBox",
	"author": "Mohsin On xRM",
	"license": "AGPL-3.0-only",
	"keywords": [
		"dataverse",
		"power-platform",
		"power-apps",
		"dynamics-365",
		"ribbon",
		"command-bar",
		"ribbon-workbench",
		"ribbon-customization",
		"ribbondiffxml",
		"studio",
		"pptb",
		"toolbox",
		"crm",
		"xrm",
		"microsoft"
	],
	"main": "index.html",
	"icon": "icons/command-bar-studio.svg",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohsinonxrm/pptb-mxrm-commandbar-studio.git"
	},
	"contributors": [
		{
			"name": "Mohsin On xRM",
			"url": "https://github.com/mohsinonxrm"
		}
	],
	"features": {
		"multiConnection": "none",
		"minAPI": "1.2.0"
	},
	"bugs": {
		"url": "https://github.com/mohsinonxrm/pptb-mxrm-commandbar-studio/issues"
	},
	"configurations": {
		"repository": "https://github.com/mohsinonxrm/pptb-mxrm-commandbar-studio",
		"website": "https://github.com/mohsinonxrm/pptb-mxrm-commandbar-studio",
		"readmeUrl": "https://raw.githubusercontent.com/mohsinonxrm/pptb-mxrm-commandbar-studio/refs/heads/main/README.md"
	},
	"files": [
		"dist",
		"icons",
		"index.html",
		"LICENSE",
		"README.md",
		"CHANGELOG.md",
		"SECURITY.md",
		"npm-shrinkwrap.json"
	],
	"type": "module",
	"scripts": {
		"dev": "vite --config vite.config.ts",
		"build": "tsc -b && vite build --config vite.config.ts",
		"build:onprem": "tsc -b && vite build --config vite.onprem.config.ts",
		"package:onprem": "node scripts/package-onprem.mjs",
		"test:package:onprem": "node --test scripts/tests/package-onprem.test.mjs",
		"preview": "vite preview --config vite.config.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src --max-warnings 0",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"test:coverage": "vitest run --config vitest.config.ts --coverage",
		"test:ui": "vitest --config vitest.config.ts --ui",
		"validate": "pptb-validate",
		"finalize-package": "npm run validate && npm run build && npm shrinkwrap",
		"release": "release-it",
		"release:dry": "release-it --dry-run",
		"release:pre": "release-it --preRelease=beta",
		"analyze": "vite build && start dist/stats.html",
		"prepare": "if [ \"$CI\" = \"true\" ]; then echo 'Skipping Husky in CI'; else husky; fi"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fluentui-contrib/react-data-grid-react-window": "^1.4.2",
		"@fluentui/react-components": "^9.62.0",
		"@fluentui/react-icons": "^2.0.290",
		"@monaco-editor/react": "^4.7.0",
		"fflate": "^0.8.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/js": "^9.25.0",
		"@pptb/types": "^1.2.3",
		"@release-it/conventional-changelog": "^10.0.6",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^18.3.21",
		"@types/react-dom": "^18.3.5",
		"@typescript-eslint/eslint-plugin": "^8.30.1",
		"@typescript-eslint/parser": "^8.30.1",
		"@vitejs/plugin-react": "^5.2.0",
		"@vitest/coverage-v8": "^3.1.2",
		"@vitest/ui": "^3.1.2",
		"eslint": "^9.25.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"eslint-plugin-vitest": "^0.5.4",
		"globals": "^16.0.0",
		"husky": "^9.1.7",
		"jsdom": "^26.1.0",
		"monaco-editor": "^0.55.1",
		"release-it": "^19.2.4",
		"rollup-plugin-visualizer": "^5.14.0",
		"typescript": "^5.8.3",
		"vite": "^7.3.3",
		"vitest": "^3.1.2"
	}
}
